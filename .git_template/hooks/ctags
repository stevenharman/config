#!/bin/sh

set -e

# Ensure Homebrew's bin is on PATH so we find a real ctags (not the anemic
# /usr/bin/ctags) even in minimal/GUI contexts that don't source our profile.
# In an interactive shell these are already present, so this is a no-op.
for dir in /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) [ -d "$dir" ] && PATH="$dir:$PATH" ;;
  esac
done
dir="$(git rev-parse --git-dir)"
trap 'rm -f "$dir/tags.$$"' EXIT INT TERM
git ls-files | \
  "${CTAGS:-ctags}" --tag-relative=yes -L - -f"$dir/tags.$$" --languages=-sql --exclude='*.json' --exclude='*.min.js' --exclude='*.min.css'
mv "$dir/tags.$$" "$dir/tags"
