#!/bin/sh

"$(git rev-parse --git-path hooks/ctags)" >/dev/null 2>&1 &

in_rebase() {
  [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]
}

# Sync the bundle on branch checkouts, but not mid-rebase: a `bundle install`
# there rewrites Gemfile.lock and any cached gems (e.g. vendor/cache), which
# git then sees as local changes and aborts the next pick. post-rewrite syncs
# once the rebase is done instead.
if [ "$1" != 0000000000000000000000000000000000000000 ] && [ "$3" = 1 ] && ! in_rebase; then
  "$(git rev-parse --git-path hooks/bundle-sync)" "$1" "$2"
fi

# Copy untracked, per-worktree local files when `git worktree add` creates a
# new tree. Detected by: this is a linked worktree (git dir under worktrees/)
# and the old ref is the null SHA (a fresh checkout).
git_dir=$(git rev-parse --git-dir)
case "$git_dir" in
  */worktrees/*)
    if [ "$1" = 0000000000000000000000000000000000000000 ]; then
      main=$(git rev-parse --path-format=absolute --git-common-dir); main=${main%/.git}
      for f in .env.local .env.test.local .env.development.local; do
        [ -f "$main/$f" ] && [ ! -e "$f" ] && cp "$main/$f" "$f"
      done

      # Share Claude local settings across worktrees by symlinking back to the
      # main worktree's copy, so edits in one place apply everywhere.
      claude_local=".claude/settings.local.json"
      if [ -f "$main/$claude_local" ] && [ ! -e "$claude_local" ] && [ ! -L "$claude_local" ]; then
        mkdir -p .claude
        ln -s "$main/$claude_local" "$claude_local"
      fi
    fi
    ;;
esac
