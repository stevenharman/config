#!/bin/sh

"$(git rev-parse --git-path hooks/ctags)" >/dev/null 2>&1 &

if [ "$1" != 0000000000000000000000000000000000000000 ]; then
  if [ "$3" = 1 ] && [ -f Gemfile ] && command -v bundle >/dev/null &&
    git diff --name-only "$1" "$2" | grep -Eq '^Gemfile|\.gemspec$'
  then
    (unset GIT_DIR; exec bundle) | grep -v '^Using ' | grep -v ' is complete'
    true
  fi
fi

# Copy untracked, per-worktree local files when `git worktree add` creates a
# new tree. Detected by: this is a linked worktree (git dir under worktrees/)
# and the old ref is the null SHA (a fresh checkout).
git_dir=$(git rev-parse --git-dir)
case "$git_dir" in
  */worktrees/*)
    if [ "$1" = 0000000000000000000000000000000000000000 ]; then
      main=$(git rev-parse --path-format=absolute --git-common-dir); main=${main%/.git}
      for f in .env.local .env.test.local .env.development.local; do
        [ -f "$main/$f" ] && [ ! -e "$f" ] && cp "$main/$f" "$f"
      done
    fi
    ;;
esac
